{
  "id": "ultra-hd",
  "name": "Ultra Hd",
  "version": "0.3.3",
  "apiVersion": 13,
  "entry": "plugin.js",
  "description": "Películas, series y TV en vivo en Ultra HD.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-ultrahd",
  "hosts": [
    {
      "host": "vegetatvv2.duckdns.org",
      "insecureHttp": true
    }
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "capabilities": [
    "home",
    "browse",
    "search",
    "resolve",
    "episodes",
    "channels",
    "catalog"
  ],
  "categories": [
    "movies",
    "series",
    "live"
  ],
  "color": "#FF6B00",
  "icon": "icon.png",
  "theme": {
    "accent": "#FF6B00",
    "onAccent": "#000000",
    "background": "#0A0A0A",
    "surface": "#1A1A1A",
    "highlight": "#FFB280"
  },
  "section": {
    "labelEn": "Ultra Hd",
    "label": "Ultra Hd"
  },
  "settings": [
    {
      "key": "connection",
      "label": "Conexión",
      "labelEn": "Connection",
      "type": "section",
      "hint": "Los servidores se obtienen solos. Cambia de uno si va mal.",
      "hintEn": "Servers are picked automatically. Switch if one misbehaves."
    },
    {
      "key": "status",
      "label": "Servidor activo",
      "labelEn": "Active server",
      "type": "status"
    },
    {
      "key": "switchServer",
      "label": "Cambiar servidor",
      "labelEn": "Switch server",
      "type": "action",
      "hint": "Prueba el siguiente de la lista",
      "hintEn": "Tries the next one in the list"
    },
    {
      "key": "refreshServers",
      "label": "Actualizar lista de servidores",
      "labelEn": "Update server list",
      "type": "action",
      "hint": "Vuelve a pedir la lista al servicio",
      "hintEn": "Asks the service for the list again"
    },
    {
      "key": "indexStatus",
      "label": "Índice de títulos",
      "labelEn": "Title index",
      "type": "status"
    },
    {
      "key": "content",
      "label": "Contenido",
      "labelEn": "Content",
      "type": "section"
    },
    {
      "key": "showAdult",
      "label": "Mostrar contenido 18+",
      "labelEn": "Show 18+ content",
      "type": "toggle",
      "default": false,
      "hint": "Apagado, las categorías adultas se ocultan",
      "hintEn": "Off, adult categories are hidden"
    },
    {
      "key": "liveSection",
      "label": "En vivo",
      "labelEn": "Live",
      "type": "section"
    },
    {
      "key": "liveFormat",
      "label": "Formato del en vivo",
      "labelEn": "Live format",
      "type": "select",
      "default": "m3u8",
      "options": [
        {
          "value": "m3u8",
          "label": "HLS (m3u8)",
          "labelEn": "HLS (m3u8)"
        },
        {
          "value": "ts",
          "label": "MPEG-TS (ts)",
          "labelEn": "MPEG-TS (ts)"
        }
      ],
      "hint": "Si un canal no carga, prueba el otro",
      "hintEn": "If a channel will not play, try the other"
    },
    {
      "key": "homeSection",
      "label": "Inicio",
      "labelEn": "Home",
      "type": "section",
      "hint": "Una fila con los canales de tu país al final de Inicio.",
      "hintEn": "A row with your country's channels at the end of Home."
